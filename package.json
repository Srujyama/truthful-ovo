{
  "name": "truthful-ovo",
  "version": "4.0.0-dev.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test src/domain.test.mjs src/recovery.test.mjs src/useAssurance.test.mjs src/engine/*.test.mjs src/assurance/*.test.mjs src/assuranceImport.test.mjs src/economics.test.mjs src/explorer/*.test.mjs src/authority/*.test.mjs server/*.test.mjs src/assurance-ui.test.mjs src/evidence-ui.test.mjs src/credit-workflow.test.mjs src/amendment-workflow.test.mjs src/credit-resolution.test.mjs src/operations.test.mjs src/clearing-house/*.test.mjs src/followups-ui.test.mjs src/correspondence.test.mjs src/history-copy.test.mjs src/document-reading.test.mjs src/review-display.test.mjs src/book/front/*.test.mjs",
    "verify:submission": "node scripts/verify-submission.mjs",
    "check": "npm test && npm run evaluate && npm run evaluate:assurance && npm run verify:submission && npm run verify:depth && npm run verify:frontier && npm run build",
    "analyze": "node scripts/analyze.mjs",
    "verify:packet": "node scripts/verify-packet.mjs",
    "evaluate": "node src/engine/evaluate.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:server": "node server/start.mjs",
    "backend": "node server/start.mjs --mode managed",
    "backend:admin": "node server/admin.mjs",
    "test:backend": "node --test server/*.test.mjs",
    "test:backend:browser": "node scripts/run-backend-browser.mjs",
    "verify:backend": "npm run test:backend && node scripts/verify-backend-evidence.mjs",
    "evaluate:assurance": "node src/assurance/evaluate.mjs",
    "verify:depth": "node scripts/verify-depth.mjs",
    "verify:assurance-packet": "node scripts/verify-assurance-packet.mjs",
    "verify:frontier": "node scripts/verify-frontier.mjs",
    "verify:exploration": "node scripts/verify-exploration.mjs",
    "verify:authority": "node scripts/verify-authority.mjs",
    "design:build": "node scripts/build-figma-kit.mjs",
    "design:check": "node scripts/verify-figma-kit.mjs && node --test scripts/figma-target-binding.test.mjs scripts/verify-figma-native.test.mjs scripts/verify-figma-system.test.mjs scripts/figma-root-inventory.test.mjs scripts/figma-expansion-manifest.test.mjs",
    "design:verify-native": "node scripts/verify-figma-native.mjs",
    "design:push": "node scripts/push-figma-kit.mjs",
    "design:verify-system": "node scripts/verify-figma-system.mjs",
    "verify:credit-workflows": "node scripts/verify-credit-workflows.mjs",
    "verify:workspace-expansion": "node scripts/verify-workspace-expansion.mjs",
    "design:prepare-expansion": "node scripts/prepare-figma-expansion.mjs",
    "test:clearing-house:browser": "node scripts/run-backend-browser.mjs --clearing-house",
    "verify:clearing-house": "node scripts/verify-clearing-house.mjs",
    "test:workspace:browser": "node scripts/run-backend-browser.mjs --redesign",
    "verify:workspace-redesign": "node scripts/verify-workspace-redesign.mjs",
    "test:workspace:records": "node scripts/run-backend-browser.mjs --records",
    "test:credits:browser": "node scripts/run-backend-browser.mjs --credit-recovery",
    "test:credits:offline": "node scripts/run-backend-browser.mjs --credit-recovery --browser-local",
    "test:workspace:all": "npm run test:workspace:browser && npm run test:workspace:records && npm run test:credits:browser && npm run test:credits:offline && npm run test:workspace:examples && npm run test:team:browser",
    "test:workspace:examples": "node scripts/run-backend-browser.mjs --examples --browser-local",
    "test:product:browser": "node scripts/run-backend-browser.mjs --product",
    "verify:product": "node scripts/verify-product-workflow.mjs",
    "test:team:browser": "node scripts/run-backend-browser.mjs --team",
    "verify:team": "node scripts/verify-team-workflow.mjs"
  },
  "dependencies": {
    "@fontsource-variable/besley": "^5.3.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
