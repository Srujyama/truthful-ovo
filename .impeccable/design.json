  "narrative": {
    "northStar": "The financial clearing house",
    "overview": "A financial clearing house gives each kind of work a place: archive, review hall, credit exchange, verified vault, execution observatory and dispatch desk. Warm paper, original isometric architecture and Pixelify place names make the overview recognizable; an ordinary ledger and exact record views carry the financial work.\n\nThe user selected Nomen\u2019s spatial, pixel and paper interaction direction. Truthful uses original Canvas geometry and finance-specific destinations, with real DOM station buttons and a persistent route into the existing task interface. Public Sans remains the reading and form face. The world is an overview of recorded facts, not evidence that scenery performs financial operations.",
    "keyCharacteristics": [
      "Warm paper and brown-green ink across world and ledger.",
      "Pixel display type paired with Public Sans reading and forms.",
      "Distinct isometric stations, anchored labels and a readable record inspector.",
      "Named financial states, exact record destinations and separate recoverable/issued/verified balances."
    ],
    "rules": [
      {
        "name": "The Recorded State Rule",
        "body": "Pair semantic color with a readable state. Issued credit and verified applied credit remain distinct, even when both use green.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Pixelify names the place and emphasizes selected amounts; Public Sans carries records, forms, explanations and dense evidence.",
        "section": "typography"
      },
      {
        "name": "The Place and Proof Rule",
        "body": "Architecture supplies spatial context; evidence, amounts and financial actions remain in readable DOM controls and task surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the paper, Pixelify and Public Sans relationship across the world and conventional ledger.",
      "Do keep station buttons and the six-station dock usable independently of Canvas interaction.",
      "Do preserve exact source revisions, action identity, readable states and the distinction between issued and applied credit.",
      "Do preserve focus, modal dismissal, mobile stacking and reduced-motion behavior."
    ],
    "donts": [
      "Don't replace the selected spatial world with the superseded neutral-white-only identity.",
      "Don't treat an illustrative courier, building or approval as a completed financial transaction.",
      "Don't copy Nomen\u2019s renderer, models, logo or media into this original implementation.",
      "Don't propagate tiny annotations, decorative eyebrows or text glyph icons as system primitives."
    ]
  }
}
