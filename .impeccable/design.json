  "narrative": {
    "northStar": "A follow-up and its documents",
    "overview": "Follow-ups is the default operating view. The same company promise, source versions, credits, proposed terms and draft remain connected through inspection and return. Public Sans, dark ink, white working surfaces and restrained blue selection serve repeated finance work. The original Office map is a secondary spatial overview. The user rejected the earlier Nomen milestone as sufficient application design; this artifact records implementation, not user approval or final runtime acceptance.",
    "keyCharacteristics": [
      "Full-width follow-up results and complete case drill-in.",
      "First-class Credits and task-specific Tasks, Companies, Documents, Activity and Reports.",
      "Exact source/draft identity, visible financial consequences and recoverable work.",
      "Original Office scene remains separate, with useful records and camera/pause/reduced-motion controls."
    ],
    "rules": [
      {
        "name": "Recorded state",
        "body": "Separate conditional offers, issued notes, applied credit, assignments and reversals; pair color with meaningful labels.",
        "section": "colors"
      },
      {
        "name": "Readable working type",
        "body": "Public Sans carries operational headings, amounts, forms and records; Pixelify belongs to Office scene identity and place labels.",
        "section": "typography"
      },
      {
        "name": "Identity and consequence",
        "body": "Preserve the same selected case, exact document version and draft through navigation and recovery; unavailable requested records do not become substitutes.",
        "section": "layout"
      },
      {
        "name": "Scene and work",
        "body": "Office supplies spatial context and actual record links; scenery does not perform or prove financial transactions.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Use plain task labels, concise copy and useful financial density.",
      "Preserve exact source versions, approval freshness, draft identity and action limits.",
      "Inspect normal-motion entry, interruption and return alongside keyboard, touch and reduced-motion behavior.",
      "Keep historical evidence distinct from current acceptance and delivery."
    ],
    "donts": [
      "Do not restore the user-rejected default-world/pixel treatment to operational finance screens.",
      "Do not treat a palette, passing build or model score as user approval.",
      "Do not copy reference identity, models or personal media.",
      "Do not claim a new public deployment, native Figma parity or connected external actions from local implementation."
    ]
  }
}
